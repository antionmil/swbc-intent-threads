# Optional. Raises the GitHub search API from 10 to 30 requests a minute while
# mining the corpus. Needs NO scopes — it only reads public data.
GITHUB_TOKEN=

# Optional, not yet wired: YouTube Data API v3, for mining comments.
YOUTUBE_API_KEY=

# Stack Exchange app key, from https://stackapps.com/apps/oauth/register
# Optional. Without it the Software Recommendations miner is capped at page 25
# (2,500 questions) and 300 requests a day. With it: the full archive, 10,000 a day.
STACK_KEY=
